# --- Mapbox (required for the map) -------------------------------------------
# Public token (pk.*) from https://account.mapbox.com/access-tokens/
# Used by the browser for tiles + search, and by the server for geocoding and
# static images.
MAPBOX_TOKEN=pk.your_public_token
# Optional: separate token for server-side calls (use this if the public token
# is URL-restricted, since server requests carry no browser Referer).
# MAPBOX_SERVER_TOKEN=pk.or_sk_token

# --- Server ------------------------------------------------------------------
PORT=8787
# PUBLIC_URL=https://maps.example.com      # used for links returned by the API
# DATA_DIR=./data

# --- API access --------------------------------------------------------------
# When set, /api/v1 calls (except health, map config, reference catalog) need
# X-API-Key: <key>  or  Authorization: Bearer <key>. Comma-separate multiple keys.
# LITEMAP_API_KEY=change-me
# CORS_ORIGINS=https://crm.example.com,https://intranet.example.com

# --- SkyFi (optional) --------------------------------------------------------
# Enables searching SkyFi's commercial archive (Vantor, Planet, Satellogic, ...)
# for recent 30-50 cm captures, with prices. Key: app.skyfi.com -> My Profile -> API.
# Searching is free; ordering happens in SkyFi.
# SKYFI_API_KEY=
